FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /src

# Recommended builds (override flags with --build-arg as needed):
#
# Default (headless CLI):
#   DOCKER_BUILDKIT=1 docker build --platform=linux/amd64 -f DockerFileLinux -t orcaslicer-linux:latest .
#
# With GUI enabled:
#   DOCKER_BUILDKIT=1 docker build --platform=linux/amd64 -f DockerFileLinux -t orcaslicer-linux:gui \
#     --build-arg SLIC3R_GUI=ON .
#
# Debug build:
#   DOCKER_BUILDKIT=1 docker build --platform=linux/amd64 -f DockerFileLinux -t orcaslicer-linux:debug \
#     --build-arg BUILD_TYPE=Debug .
#
# With tests:
#   DOCKER_BUILDKIT=1 docker build --platform=linux/amd64 -f DockerFileLinux -t orcaslicer-linux:test \
#     --build-arg BUILD_TESTS=ON .


# Install system dependencies for OrcaSlicer build
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        automake \
        autoconf \
        build-essential \
        cmake \
        eglexternalplatform-dev \
        extra-cmake-modules \
        file \
        g++ \
        gettext \
        git \
        libcurl4-openssl-dev \
        libdbus-1-dev \
        libglew-dev \
        libgtk-3-dev \
        libmspack-dev \
        libsecret-1-dev \
        libssl-dev \
        libtool \
        libudev-dev \
        locales \
        ninja-build \
        ccache \
        pkg-config \
        texinfo \
        wget \
        zlib1g-dev && \
    # Try to install libwebkit2gtk (version may vary by distro)
    (apt-get install -y libwebkit2gtk-4.0-dev || \
     apt-get install -y libwebkit2gtk-4.1-dev || true) && \
    # Optional: libspnav for 3D mouse support (may not be available in all repos)
    (apt-get install -y libspnav-dev || true) && \
    # Configure UTF-8 locale for proper archive extraction
    locale-gen en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*

# Set locale environment for proper UTF-8 handling
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Use ccache for faster rebuilds
ENV CC="ccache gcc" \
    CXX="ccache g++" \
    CCACHE_DIR="/ccache" \
    CCACHE_MAXSIZE="5G"

# Copy dependencies directory (deps will be built in cached layers)
COPY deps/ /src/deps/

# Build arguments for configuration
ARG BUILD_TYPE=Release
ARG SLIC3R_GUI=OFF
ARG SLIC3R_HEADLESS=ON
ARG SLIC3R_STATIC=ON
ARG BUILD_TESTS=OFF

# Configure and build dependencies in cached layers
RUN --mount=type=cache,target=/ccache \
    mkdir -p deps/build && \
    cd deps/build && \
    cmake .. \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=x86_64 \
        -DCMAKE_C_COMPILER=gcc \
        -DCMAKE_CXX_COMPILER=g++ \
        -DSLIC3R_HEADLESS=${SLIC3R_HEADLESS} \
        -DDESTDIR=/src/deps/build/OrcaSlicer_dep

# Build Boost (separate layer for better caching since it's the largest)
RUN --mount=type=cache,target=/ccache \
    cd deps/build && \
    cmake --build . --config ${BUILD_TYPE} --target dep_Boost --parallel 4

# Build GMP and MPFR (math libraries needed for CGAL)
RUN --mount=type=cache,target=/ccache \
    cd deps/build && \
    rm -rf dep_GMP-prefix/src/dep_GMP-build dep_MPFR-prefix/src/dep_MPFR-build && \
    rm -f dep_GMP-prefix/src/dep_GMP-stamp/dep_GMP-configure \
          dep_GMP-prefix/src/dep_GMP-stamp/dep_GMP-build \
          dep_GMP-prefix/src/dep_GMP-stamp/dep_GMP-install \
          dep_MPFR-prefix/src/dep_MPFR-stamp/dep_MPFR-configure \
          dep_MPFR-prefix/src/dep_MPFR-stamp/dep_MPFR-build \
          dep_MPFR-prefix/src/dep_MPFR-stamp/dep_MPFR-install && \
    cmake --build . --config ${BUILD_TYPE} --target dep_GMP dep_MPFR -- -j4

# Build CGAL (computational geometry library)
RUN --mount=type=cache,target=/ccache \
    cd deps/build && \
    cmake --build . --config ${BUILD_TYPE} --target dep_CGAL -- -j4

# Build TBB, Cereal, NLopt, libnoise
RUN --mount=type=cache,target=/ccache \
    cd deps/build && \
    cmake --build . --config ${BUILD_TYPE} --target dep_TBB dep_Cereal dep_NLopt dep_libnoise -- -j4

# Build Qhull
RUN --mount=type=cache,target=/ccache \
    cd deps/build && \
    cmake --build . --config ${BUILD_TYPE} --target dep_Qhull -- -j4

# Build all remaining dependencies (ZLIB, FREETYPE, EXPAT, PNG, JPEG, etc.)
RUN --mount=type=cache,target=/ccache \
    cd deps/build && \
    cmake --build . --config ${BUILD_TYPE} --target deps -- -j4

# Configure OrcaSlicer with bind-mounted source
RUN --mount=type=bind,source=.,target=/work,rw \
    --mount=type=cache,target=/build \
    --mount=type=cache,target=/ccache \
    cmake -S /work -B /build -G Ninja \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DCMAKE_SYSTEM_NAME=Linux \
      -DCMAKE_C_COMPILER=gcc \
      -DCMAKE_CXX_COMPILER=g++ \
      -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
      -DSLIC3R_GUI=${SLIC3R_GUI} \
      -DSLIC3R_HEADLESS=${SLIC3R_HEADLESS} \
      -DSLIC3R_DESKTOP_INTEGRATION=OFF \
      -DSLIC3R_STATIC=${SLIC3R_STATIC} \
      -DBUILD_TESTS=${BUILD_TESTS} \
      -DORCA_TOOLS=ON \
      -DDEP_BUILD_DIR=/src/deps/build \
      -DCMAKE_PREFIX_PATH=/src/deps/build/OrcaSlicer_dep/usr/local

# Build OrcaSlicer
RUN --mount=type=bind,source=.,target=/work,rw \
    --mount=type=cache,target=/build \
    --mount=type=cache,target=/ccache \
    cmake --build /build --config ${BUILD_TYPE} --target OrcaSlicer -- -j4

# Optionally run tests if BUILD_TESTS=ON
RUN --mount=type=bind,source=.,target=/work,rw \
    --mount=type=cache,target=/build \
    --mount=type=cache,target=/ccache \
    if [ "$BUILD_TESTS" = "ON" ]; then \
        cmake --build /build --config ${BUILD_TYPE} --target tests/all && \
        cd /build && ctest --output-on-failure; \
    fi

# Copy build artifacts from cache mount into final image filesystem
RUN --mount=type=cache,target=/build \
    mkdir -p /artifacts && \
    cp /build/src/orca-slicer /artifacts/ && \
    ls -lh /artifacts/ && \
    echo "Binary info:" && \
    file /artifacts/orca-slicer && \
    ldd /artifacts/orca-slicer || true

# Keep container interactive for debugging
CMD ["/bin/bash"]
